{
  "mcpServers": {
    "api": {
      "type": "stdio",
      "command": "npx",
      "args": ["server-api"],
      "env": {
        "API_KEY": "${SYNTHETIC_OPENAI_KEY}",
        "GITHUB_TOKEN": "${SYNTHETIC_GITHUB_TOKEN}",
        "AWS_ACCESS_KEY": "${SYNTHETIC_AWS_ACCESS_KEY}",
        "AWS_SECRET_KEY": "${SYNTHETIC_AWS_SECRET_KEY}",
        "PRIVATE_KEY": "${SYNTHETIC_PRIVATE_KEY}",
        "DATABASE_URL": "${SYNTHETIC_DATABASE_URL}",
        "AUTH_HEADER": "${SYNTHETIC_BEARER_TOKEN}"
      }
    }
  }
}
